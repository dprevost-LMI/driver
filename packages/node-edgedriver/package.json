{
  "name": "edgedriver",
  "version": "6.3.1",
  "description": "Microsofts' EdgeDriver for Node.js",
  "homepage": "https://webdriver.io",
  "license": "MIT",
  "author": {
    "name": "Barrett Sonntag",
    "email": "barrett@sosuke.com",
    "url": "https://www.sosuke.com"
  },
  "keywords": [
    "edgedriver",
    "edgedriverserver",
    "webdriver"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/webdriverio-community/node-edgedriver.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": [
      {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./dist/cjs/index.js"
    ]
  },
  "bin": {
    "edgedriver": "./bin/edgedriver.js"
  },
  "scripts": {
    "build": "tsc -b . && node ../../scripts/copy-cjs-pkg.mjs",
    "clean": "rimraf ./node_modules ./dist",
    "postinstall": "test -f ./dist/install.js && node ./dist/install.js || echo \"Skipping install, project not build!\"",
    "test": "run-s test:*",
    "test:lint": "eslint",
    "test:unit": "vitest --run",
    "watch": "pnpm run build -- --watch"
  },
  "dependencies": {
    "@wdio/logger": "^9.29.1",
    "@zip.js/zip.js": "^2.8.11",
    "decamelize": "^6.0.1",
    "edge-paths": "^3.0.5",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "which": "^6.0.1"
  }
}
